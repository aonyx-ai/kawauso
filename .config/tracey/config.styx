// Tracey links the requirements in the specifications to the code that
// implements them and to the tests that verify them. Each crate has its own
// specification and its own entry below, so that coverage is reported per
// crate. See https://tracey.bearcove.eu/ for the configuration reference.
@schema {id crate:tracey-config@1, cli tracey}

specs (
    {
        name kawauso
        source_url https://github.com/aonyx-ai/kawauso
        include (crates/kawauso/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/kawauso/src/**/*.rs)
                test_include (crates/kawauso/tests/**/*.rs)
            }
        )
    }
    {
        name kawauso-config
        source_url https://github.com/aonyx-ai/kawauso
        include (crates/kawauso-config/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/kawauso-config/src/**/*.rs)
                test_include (crates/kawauso-config/tests/**/*.rs)
            }
        )
    }
    {
        name kawauso-process
        source_url https://github.com/aonyx-ai/kawauso
        include (crates/kawauso-process/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/kawauso-process/src/**/*.rs)
                test_include (crates/kawauso-process/tests/**/*.rs)
            }
        )
    }
    {
        name kawauso-project
        source_url https://github.com/aonyx-ai/kawauso
        include (crates/kawauso-project/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/kawauso-project/src/**/*.rs)
                test_include (crates/kawauso-project/tests/**/*.rs)
            }
        )
    }
)
